        <!-- Monitoring/response bar spanning all three -->
        <mxCell id="monitor" value="Continuous monitoring across all phases: SIEM (Splunk / Sentinel / Elastic) correlating proxy exploit + metadata query + cross-cluster credential use in real time, EDR/XDR on affected nodes, AARM-style pre-execution policy gate for human-in-the-loop checkpoint on agent actions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=#0b4ea2;fontColor=#ffffff;align=left;verticalAlign=middle;spacing=10;fontFamily=Helvetica;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="1040" height="50" as="geometry" />
        </mxCell>

        <!-- LESSONS LEARNED strip -->
        <mxCell id="lesson1" value="Assume the isolation boundary itself can fail, not just the task inside it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8952f;strokeColor=#8a6f1f;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lesson2" value="Credential hygiene failures aren't AI-specific. They're conventional gaps an autonomous agent exploits far faster than a human attacker would." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8952f;strokeColor=#8a6f1f;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="lesson3" value="A model's safety refusal layer can block your own incident response. Plan a fallback path before you need one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b8952f;strokeColor=#8a6f1f;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="500" width="320" height="90" as="geometry" />
        </mxCell>

