        <!-- ATTACK ROW -->
        <mxCell id="atk1" value="Sandbox Escape&#10;Zero-day in package registry cache proxy escapes the isolated evaluation environment&#10;&#10;ATLAS (adversarial technique, ID unconfirmed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7d2b26;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="atk2" value="Initial Access&#10;HDF5 file-read + Jinja2 template injection reach local secrets and achieve code execution&#10;&#10;ATT&amp;CK T1059, T1552.001" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7d2b26;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="atk3" value="Lateral Movement&#10;Metadata credential harvested, privilege escalation, shared cluster-admin credential reused across clusters&#10;&#10;ATT&amp;CK T1552.005, T1078.004" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7d2b26;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="320" height="120" as="geometry" />
        </mxCell>
