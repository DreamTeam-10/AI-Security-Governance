        </mxCell>
        <mxCell id="atk_arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;" edge="1" parent="1" source="atk2" target="atk3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DEFENSE ROW -->
        <mxCell id="def1" value="Execution Isolation&#10;Disposable microVMs for untrusted workloads&#10;&#10;Tools: gVisor, Firecracker, Kata Containers&#10;D3FEND: Isolate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=#0b4ea2;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="def2" value="Secrets + Input Hardening&#10;No secrets in process env; reject local-resource reads in pipeline configs&#10;&#10;Tools: AWS KMS/Secrets Manager, HashiCorp Vault&#10;AWS WA: Security Pillar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=#0b4ea2;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="280" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="def3" value="Least-Privilege Credentials&#10;IMDSv2 enforcement, JIT short-lived elevation instead of standing cluster-admin&#10;&#10;Tools: GuardDuty/Wiz, AWS IAM Roles Anywhere + STS, CyberArk, Entra PIM&#10;AWS WA: Security Pillar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a73e8;strokeColor=#0b4ea2;fontColor=#ffffff;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1">
